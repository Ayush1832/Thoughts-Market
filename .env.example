# ============================================================
# REQUIRED
# ============================================================

# Get your Kuest CLOB Auth credentials by connecting your EVM wallet (Polygon, 0x...) at https://auth.kuest.com
KUEST_ADDRESS=""
KUEST_API_KEY=""
KUEST_API_SECRET=""
KUEST_PASSPHRASE=""

# Admin wallets (comma-separated, EVM 0x... addresses on Polygon)
ADMIN_WALLETS=""

# Your REOWN APPKIT project id http://dashboard.reown.com/
REOWN_APPKIT_PROJECT_ID=""

# Random 32 characters – generate one on "generate secret" button https://www.better-auth.com/docs/installation#set-environment-variables
# Changing this value will invalidate all user sessions AND encrypted credentials, requiring users to log in and re-authenticate for trading.
BETTER_AUTH_SECRET=""

# Vercel Cron Jobs (Create a random secret of at least 16 characters)
CRON_SECRET=""

# ============================================================
# OPTIONAL
# ============================================================

# Disable Next.js image optimization
DISABLE_IMAGE_OPTIMIZATION=false

# Ops email alerts (Resend, https://resend.com) — fires when a deposit/sweep/withdrawal cron job fails.
# Leave blank to disable alerting.
RESEND_API_KEY=""
OPS_ALERT_EMAIL=""
OPS_ALERT_FROM=""

# PostgreSQL runtime connection (required outside Vercel/Supabase integration flow)
POSTGRES_URL=""

# Supabase credentials (optional outside Supabase mode; if one is set, both are required)
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""

# S3-compatible storage (required when SUPABASE_* is not configured)
S3_BUCKET=""
S3_ENDPOINT=""
S3_REGION=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_URL=""
S3_FORCE_PATH_STYLE=true

# Sentry monitoring https://sentry.io/
SENTRY_DSN=""
SENTRY_ORG=""
SENTRY_PROJECT=""
SENTRY_AUTH_TOKEN=""

# Private keys used to sign recurring event creations
# Format: comma-separated list of private keys no spaces (eg. key1,key2,key3)
EVENT_CREATION_SIGNER_PRIVATE_KEYS=

# Custodial HD deposit-address master mnemonic (BIP-39). Derives each user's
# per-coin/network deposit address. KEEP SECRET (use a KMS in production). Leave
# empty to disable custodial deposit addresses (fail-closed).
DEPOSIT_HD_MNEMONIC=

# Treasury wallet address that swept deposits are consolidated into.
DEPOSIT_TREASURY_ADDRESS=
# Hot wallet private key that funds POL gas to sweep ERC-20 deposits (keep secret).
DEPOSIT_GAS_PRIVATE_KEY=
# Hot wallet private key that pays out user withdrawals (keep secret).
WITHDRAWAL_HOT_WALLET_PRIVATE_KEY=
# Omnibus trading: private key for the single account that signs every user's
# order on the CLOB (CLOB credentials are the KUEST_* values). Keep secret.
OMNIBUS_SIGNER_PRIVATE_KEY=

# Per-chain deposit RPC URLs. Each chain is silently excluded from deposit
# support (no error, no warning) if its var is unset — Polygon falls back to
# a public default RPC when DEPOSIT_RPC_POLYGON is empty, but every other
# chain below has no fallback and requires its var to be set.
DEPOSIT_RPC_POLYGON=
DEPOSIT_RPC_ETHEREUM=
DEPOSIT_RPC_BSC=
DEPOSIT_RPC_AVALANCHE=
DEPOSIT_RPC_ARBITRUM=
DEPOSIT_RPC_BASE=
DEPOSIT_RPC_OPTIMISM=
# Ronin/Hyperliquid currently only support native-coin (RON/HYPE) deposits —
# no stablecoin contract is configured for either chain yet.
DEPOSIT_RPC_RONIN=
DEPOSIT_RPC_HYPERLIQUID=

# Tron: TRC-20 USDT + native TRX deposits/withdrawals.
TRON_RPC_URL=
TRONGRID_API_KEY=
TRON_TREASURY_ADDRESS=
# Independently funded key that pays TRX gas for TRC-20 sweeps (keep secret).
TRON_GAS_PRIVATE_KEY=
# Independently funded hot wallet that pays out Tron withdrawals (keep secret).
TRON_HOT_WALLET_PRIVATE_KEY=
# Treasury-address signing key, used only by the admin "Pay Out to Client"
# flow to send TRC-20 USDT directly to the client's payout address (set from
# the admin panel, not an env var). Must derive TRON_TREASURY_ADDRESS
# exactly, or payouts refuse to run. Keep secret.
TRON_TREASURY_PRIVATE_KEY=

# Solana: native SOL + SPL USDC/USDT deposits/withdrawals.
SOLANA_RPC_URL=
SOLANA_TREASURY_ADDRESS=
# Independently funded key (base58) that pays SOL rent/fees for SPL sweeps (keep secret).
SOLANA_GAS_PRIVATE_KEY=
# Independently funded hot wallet (base58) that pays out Solana withdrawals (keep secret).
SOLANA_HOT_WALLET_PRIVATE_KEY=
# Treasury-address signing key (base58), used only by the admin "Pay Out to
# Client" flow to bridge SOL/USDC/USDT to Tron USDT. Must derive
# SOLANA_TREASURY_ADDRESS exactly, or payouts refuse to run. Keep secret.
SOLANA_TREASURY_PRIVATE_KEY=

# Bitcoin: native BTC deposits/withdrawals.
# Esplora-compatible API base (optional, defaults to https://mempool.space/api).
BITCOIN_API_BASE=
BITCOIN_TREASURY_ADDRESS=
# Independently funded WIF-format hot wallet that pays out Bitcoin withdrawals (keep secret).
BITCOIN_HOT_WALLET_PRIVATE_KEY=
# Treasury-address signing key (WIF format), used only by the admin "Pay Out
# to Client" flow to bridge BTC to Tron USDT. Must derive
# BITCOIN_TREASURY_ADDRESS exactly, or payouts refuse to run. Keep secret.
BITCOIN_TREASURY_PRIVATE_KEY=

# Admin treasury payout: bridges swept EVM/Bitcoin/Solana/Tron treasury
# balances to the client's Tron address as TRC-20 USDT. The destination
# address is no longer set here — configure it from the admin panel at
# Finance > Treasury > Client Payout Address instead.
# Turns the existing DEPOSIT_TREASURY_ADDRESS into a signing hot wallet for
# EVM-chain treasury payouts. Must derive DEPOSIT_TREASURY_ADDRESS exactly,
# or payouts refuse to run. Keep secret.
TREASURY_PRIVATE_KEY=
